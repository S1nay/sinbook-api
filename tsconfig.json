{
  "compilerOptions": {
    "module": "nodenext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noErrorTruncation": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "#adapters/*": ["./src/adapters/*"],
      "#auth/*": ["./src/auth/*"],
      "#comment/*": ["./src/comment/*"],
      "#conversation/*": ["./src/conversation/*"],
      "#core/*": ["./src/core/*"],
      "#file/*": ["./src/file/*"],
      "#follows/*": ["./src/follows/*"],
      "#like/*": ["./src/like/*"],
      "#message/*": ["./src/message/*"],
      "#notification/*": ["./src/notification/*"],
      "#openapi/*": ["./src/openapi/*"],
      "#post/*": ["./src/post/*"],
      "#prisma/*": ["./src/prisma/*"],
      "#user/*": ["./src/user/*"],
      "#utils/*": ["./src/utils/*"]
    }
  }
}
